# Module B (assistant) - example settings. Copy to .env (git-ignored) or export them; real values
# never go in the repository. Locally, `source local.env.sh` from the repository root sets most of
# these and keeps secrets in the git-ignored local.secrets.sh.

# --- core -------------------------------------------------------------------------------------
APP_ENV=development                      # anything else is production (strict checks)
CHAT_DATABASE_URL=host=127.0.0.1 port=5440 dbname=admitai_local user=admitai_chat
CHAT_ADMIN_DATABASE_URL=host=127.0.0.1 port=5440 dbname=admitai_local user=postgres
KNOWLEDGE_API_URL=http://127.0.0.1:8100
EXPERIENCE_API_URL=http://127.0.0.1:8200
LLM_BASE_URL=http://127.0.0.1:11434/v1   # LiteLLM / Ollama (OpenAI-compatible)
LLM_API_KEY=local

# --- languages (language.py) -------------------------------------------------------------------
# Languages the answer model writes itself; others are translated or templated.
NATIVE_ANSWER_LANGUAGES=en
# Languages answered only in their own language (templates or the admissions team when no
# trusted translation exists).
SAME_LANGUAGE_ONLY=hi,kn
# Translate checked English answers for every college (only with a model that passed a test read
# by a native speaker). Empty by default.
TRANSLATED_ANSWER_LANGUAGES=
# For colleges that opted in to Gemini (pack.yaml model_policy.external: gemini): Gemini
# translates their checked English answers into these languages...
GEMINI_TRANSLATED_LANGUAGES=hi,kn
# ...and puts their Hindi and Kannada questions into English first (1 = on).
TRANSLATE_QUESTIONS=1

# --- Gemini (Level 2, per college opt-in) ------------------------------------------------------
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite

# --- speech: local models (always available) -----------------------------------------------------
VOICE_MODEL_DIR=.local/models
WHISPER_SIZE=base
WHISPER_SIZE_INDIC=small
PIPER_VOICE=en_US-lessac-medium

# --- speech: Sarvam AI (Hindi and Kannada voice, code-mixed speech) ------------------------------
# Unset: speech stays on Whisper/Piper and Hindi/Kannada replies are text only.
SARVAM_API_KEY=your-sarvam-api-subscription-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix                 # codemix (English words in English) | transcribe | verbatim
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_SPEAKERS=en=simran_en_customer,hi=simran_hi_assistant,kn=chaitra_kn_conversation
SARVAM_TIMEOUT_S=15
SARVAM_RETRIES=2
# auto (default): Sarvam hears every recording when it has a key; English is spoken by Piper,
# Hindi and Kannada by Sarvam. local: Whisper/Piper only. sarvam: Sarvam for everything.
SPEECH_TO_TEXT_PROVIDER=auto
TEXT_TO_SPEECH_PROVIDER=auto

# --- Retell AI (phone and web calls) -------------------------------------------------------------
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx   # set by scripts/retell_agent.py

# --- Vapi (phone calls in and out, English; separate from Retell) --------------------------------
VAPI_API_KEY=your-vapi-private-key                 # server side only, never in a browser
VAPI_ASSISTANT_ID=your-saved-vapi-assistant-id     # its voice, greeting and transcriber are used
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id     # the number outbound calls come from
VAPI_PUBLIC_URL=https://your-public-address        # this service, as Vapi reaches it (tunnel)
VAPI_SERVER_SECRET=at-least-24-random-characters   # Vapi sends it back on every request
VAPI_ANSWERS=engine                                # engine (checked answers) | assistant (its own model)
VAPI_TENANT_ID=college-uuid-for-unmapped-numbers   # one-college set-ups

# --- WhatsApp Business Platform (Cloud API) ------------------------------------------------------
# Without WHATSAPP_TOKEN replies go to chat.wa_outbox (local prototype, tests) and voice notes
# cannot be downloaded.
WHATSAPP_TOKEN=your-cloud-api-token
WHATSAPP_APP_SECRET=your-meta-app-secret          # verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
CONTACT_SALT=at-least-16-random-characters
WHATSAPP_VOICE_REPLIES=1                          # a voice note is answered with a voice note too
