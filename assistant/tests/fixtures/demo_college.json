  {
   "id": "a02b1f57-1edf-52b9-ac44-6eadac2a33a4",
   "kind": "chunk",
   "content": "The department has a central workshop with lathe, milling and welding sections, a CNC lab, a thermal engineering lab and a 3D printing lab. Workshop sessions run from 09:00 to 13:00.",
   "keywords": "",
   "citation": {
    "source_type": "document",
    "document_id": "813cc23d-1e75-5a82-a6f5-05d401ea502d",
