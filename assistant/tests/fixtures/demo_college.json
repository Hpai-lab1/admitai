  {
   "id": "436c1e65-d33b-51e2-bcca-6357d52cc95c",
   "kind": "chunk",
   "content": "First-year students share triple rooms; senior students may apply for double rooms. Every room has a bed, study table, chair and wardrobe for each student. Wi-Fi is available in all hostel blocks.",
   "keywords": "",
   "citation": {
    "source_type": "document",
    "document_id": "3e85cff5-a678-5c4b-904c-753d31abd43d",
