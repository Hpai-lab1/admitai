    "url": null
   }
  },
  {
   "id": "90e73836-dceb-5411-8312-93fef2b1a223",
   "kind": "chunk",
   "content": "Electives include automobile engineering, robotics, additive manufacturing, renewable energy systems and finite element analysis.",
   "keywords": "",
   "citation": {
    "source_type": "document",
    "document_id": "813cc23d-1e75-5a82-a6f5-05d401ea502d",
