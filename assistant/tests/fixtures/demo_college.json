  {
   "id": "84632c35-02ae-520e-9b0a-9f6c4d64e49f",
   "kind": "chunk",
   "content": "Graduates work in automotive, manufacturing, energy and design companies, or continue to M.Tech or MS programmes.",
   "keywords": "",
   "citation": {
    "source_type": "document",
    "document_id": "813cc23d-1e75-5a82-a6f5-05d401ea502d",
