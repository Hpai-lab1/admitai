# Module A settings for the self-learning knowledge layer (docs/self-learning/README.md).
# Copy the lines you need into your local, git-ignored environment. Placeholders only.

# Off by default. With it off, Module A behaves exactly as before.
KNOWLEDGE_SELF_LEARNING_ENABLED=false
# Required when the layer is on: a long random string, kept secret, never committed.
LEARNING_SESSION_SALT=change-me-to-a-long-random-string

# Optional (defaults shown)
LEARNING_MIN_AGREEING_SESSIONS=3
LEARNING_MIN_TRUST=0.6
LEARNING_POLL_S=5
LEARNING_AUTO_LIVE=alias,retrieval_boost,curated_from_source
LEARNING_CLASSIFIER=llm
# LEARNING_CLASSIFIER_MODEL=        # default: KB_DRAFT_MODEL, then ANSWER_MODEL
LEARNING_MAX_FEEDBACK_PER_HOUR=10
LEARNING_REFETCH_AFTER_H=24
LEARNING_BOOST_SIMILARITY=0.85
LEARNING_ROLLBACK_MIN_VOTES=5
LEARNING_ROLLBACK_DOWN_RATIO=0.6
LEARNING_GATE_SAMPLE=20
LEARNING_BACKFILL_H=24
