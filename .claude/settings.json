{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit run:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:langchain-ai.github.io)",
      "WebFetch(domain:docs.litellm.ai)",
      "WebFetch(domain:docs.livekit.io)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:docs.python.org)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(npm install:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker run:*)",
      "Bash(curl:*)",
      "Bash(rm:*)",
      "Edit(./contracts/**)",
      "Edit(./deploy/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(dpkg:*)",
      "Bash(snap:*)",
      "Bash(systemctl:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",
      "Bash(docker kill:*)",
      "Bash(docker system prune:*)",
      "Bash(nvidia-smi -r:*)"
    ]
  }
}
